# ==============================================================================
# LogiSphere Environment Configuration Template
# ==============================================================================
# Usage:
# 1. For local development with Docker Compose:
#    Copy this file to `.env` in the project root:
#      cp .env.example .env
#    The default values below match the local Docker Compose configuration.
#
# 2. For GitLab CI/CD or Production deployments:
#    Configure these variables in your GitLab project settings:
#    Settings > CI/CD > Variables (set Masked and Protected for sensitive tokens).
#    DO NOT commit `.env` containing real credentials into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Credentials & Configuration (MySQL 8.0)
# ------------------------------------------------------------------------------
# Root password for the MySQL container
MYSQL_ROOT_PASSWORD=root

# Common application user and password for Spring Boot microservices
DB_USERNAME=root
DB_PASSWORD=root

# Microservice Database URLs (Docker Compose container networking)
AUTH_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_auth_db
PRODUCT_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_product_db
INVENTORY_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_inventory_db
ORDER_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_order_db
SHIPMENT_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_shipment_db
DELIVERY_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/logisphere_delivery_db

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Security
# ------------------------------------------------------------------------------
# HMAC-SHA256 signing secret key (minimum 256 bits / 32+ characters).
# In production / CI, generate a strong random secret and inject via CI/CD variable.
# For local development, omitting this defaults to the compatible dev key.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# ------------------------------------------------------------------------------
# 3. Service Discovery & Inter-Service URLs
# ------------------------------------------------------------------------------
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

SERVICE_AUTH_URL=http://auth-service:8082
SERVICE_PRODUCT_URL=http://product-service:8083
SERVICE_INVENTORY_URL=http://inventory-service:8084
SERVICE_SHIPMENT_URL=http://shipment-service:8086
SERVICE_DELIVERY_URL=http://delivery-service:8087

# ------------------------------------------------------------------------------
# 4. Message Broker (Apache Kafka & Zookeeper)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ZOOKEEPER_CLIENT_PORT=2181

# ------------------------------------------------------------------------------
# 5. External Exposed Ports (Host Port Mapping)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
EUREKA_PORT=8761
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 6. Frontend Environment Configuration (Vite)
# ------------------------------------------------------------------------------
# Base URL for API Gateway accessed from the browser
VITE_API_BASE_URL=http://localhost:8080
